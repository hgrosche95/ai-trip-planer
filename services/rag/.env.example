RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_LOG_LEVEL=INFO

# Dieselbe Datenbank wie apps/api/.env - bewusst ohne RAG_-Präfix, ist
# dasselbe Secret, keine zweite Kopie pflegen.
DATABASE_URL="postgresql://trip_planner:trip_planner@localhost:5432/trip_planner"

# Nur für die Ingestion-Pipeline (rag-ingest) relevant, Default passt für
# lokale Entwicklung.
RAG_CHUNK_MAX_TOKENS=100
RAG_CHUNK_OVERLAP_TOKENS=20
