{
    "openapi": "3.1.0",
    "info": {
        "title": "RAG Service",
        "version": "0.1.0"
    },
    "paths": {
        "/health": {
            "get": {
                "summary": "Health",
                "operationId": "health_health_get",
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HealthResponse"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/embed": {
            "post": {
                "summary": "Embed",
                "operationId": "embed_embed_post",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/EmbedRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/EmbedResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        },
        "/search": {
            "post": {
                "summary": "Search",
                "operationId": "search_search_post",
                "requestBody": {
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/SearchRequest"
                            }
                        }
                    },
                    "required": true
                },
                "responses": {
                    "200": {
                        "description": "Successful Response",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/SearchResponse"
                                }
                            }
                        }
                    },
                    "422": {
                        "description": "Validation Error",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/HTTPValidationError"
                                }
                            }
                        }
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "EmbedRequest": {
                "properties": {
                    "texts": {
                        "items": {
                            "type": "string"
                        },
                        "type": "array",
                        "minItems": 1,
                        "title": "Texts",
                        "description": "Zu embeddende Texte"
                    },
                    "input_type": {
                        "$ref": "#/components/schemas/InputType",
                        "description": "query f\u00c3\u00bcr Suchanfragen, passage f\u00c3\u00bcr zu indexierende Dokumente",
                        "default": "passage"
                    }
                },
                "type": "object",
                "required": [
                    "texts"
                ],
                "title": "EmbedRequest"
            },
            "EmbedResponse": {
                "properties": {
                    "embeddings": {
                        "items": {
                            "items": {
                                "type": "number"
                            },
                            "type": "array"
                        },
                        "type": "array",
                        "title": "Embeddings"
                    },
                    "model": {
                        "type": "string",
                        "title": "Model"
                    },
                    "dimensions": {
                        "type": "integer",
                        "title": "Dimensions"
                    }
                },
                "type": "object",
                "required": [
                    "embeddings",
                    "model",
                    "dimensions"
                ],
                "title": "EmbedResponse"
            },
            "HTTPValidationError": {
                "properties": {
                    "detail": {
                        "items": {
                            "$ref": "#/components/schemas/ValidationError"
                        },
                        "type": "array",
                        "title": "Detail"
                    }
                },
                "type": "object",
                "title": "HTTPValidationError"
            },
            "HealthResponse": {
                "properties": {
                    "status": {
                        "type": "string",
                        "title": "Status"
                    },
                    "model": {
                        "type": "string",
                        "title": "Model"
                    }
                },
                "type": "object",
                "required": [
                    "status",
                    "model"
                ],
                "title": "HealthResponse"
            },
            "InputType": {
                "type": "string",
                "enum": [
                    "query",
                    "passage"
                ],
                "title": "InputType",
                "description": "Ob ein Text eine Suchanfrage oder ein zu indexierendes Dokument ist.\n\nBei Pr\u00c3\u00a4fix-Modellen wie der E5-Familie (intfloat/multilingual-e5-*)\nwerden Anfrage- und Dokumenttexte unterschiedlich vorverarbeitet - siehe\nembeddings.py. F\u00c3\u00bcr das aktuell konfigurierte Modell hat dieses Feld\nkeine Auswirkung, existiert aber, damit ein Modellwechsel sp\u00c3\u00a4ter keine\nBreaking Change am API-Vertrag ist."
            },
            "SearchRequest": {
                "properties": {
                    "query": {
                        "type": "string",
                        "minLength": 1,
                        "title": "Query"
                    },
                    "top_k": {
                        "type": "integer",
                        "maximum": 50.0,
                        "minimum": 1.0,
                        "title": "Top K",
                        "default": 5
                    },
                    "min_score": {
                        "type": "number",
                        "title": "Min Score",
                        "description": "Minimaler \u00c3\u201ehnlichkeits-Score (siehe SearchResult.score). 0.0 = keine Filterung.",
                        "default": 0.0
                    }
                },
                "type": "object",
                "required": [
                    "query"
                ],
                "title": "SearchRequest"
            },
            "SearchResponse": {
                "properties": {
                    "results": {
                        "items": {
                            "$ref": "#/components/schemas/SearchResult"
                        },
                        "type": "array",
                        "title": "Results"
                    },
                    "reranked": {
                        "type": "boolean",
                        "title": "Reranked"
                    }
                },
                "type": "object",
                "required": [
                    "results",
                    "reranked"
                ],
                "title": "SearchResponse"
            },
            "SearchResult": {
                "properties": {
                    "content": {
                        "type": "string",
                        "title": "Content"
                    },
                    "score": {
                        "type": "number",
                        "title": "Score",
                        "description": "Ohne Reranking: 1 - Cosine-Distanz (ungef\u00c3\u00a4hr 0..1, h\u00c3\u00b6her = \u00c3\u00a4hnlicher). Mit Reranking: roher Cross-Encoder-Score (andere Skala, ebenfalls h\u00c3\u00b6her = besser)."
                    },
                    "document_title": {
                        "type": "string",
                        "title": "Document Title"
                    },
                    "document_source": {
                        "type": "string",
                        "title": "Document Source"
                    },
                    "document_url": {
                        "anyOf": [
                            {
                                "type": "string"
                            },
                            {
                                "type": "null"
                            }
                        ],
                        "title": "Document Url"
                    },
                    "document_license": {
                        "type": "string",
                        "title": "Document License"
                    }
                },
                "type": "object",
                "required": [
                    "content",
                    "score",
                    "document_title",
                    "document_source",
                    "document_url",
                    "document_license"
                ],
                "title": "SearchResult"
            },
            "ValidationError": {
                "properties": {
                    "loc": {
                        "items": {
                            "anyOf": [
                                {
                                    "type": "string"
                                },
                                {
                                    "type": "integer"
                                }
                            ]
                        },
                        "type": "array",
                        "title": "Location"
                    },
                    "msg": {
                        "type": "string",
                        "title": "Message"
                    },
                    "type": {
                        "type": "string",
                        "title": "Error Type"
                    },
                    "input": {
                        "title": "Input"
                    },
                    "ctx": {
                        "type": "object",
                        "title": "Context"
                    }
                },
                "type": "object",
                "required": [
                    "loc",
                    "msg",
                    "type"
                ],
                "title": "ValidationError"
            }
        }
    }
}
