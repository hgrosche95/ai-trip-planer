# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

DATABASE_URL="postgresql://trip_planner:trip_planner@localhost:5432/trip_planner"

# --- LLM-Provider ---
# groq (Standard, kostenlos) oder anthropic
LLM_PROVIDER=groq

# Groq (https://console.groq.com/keys), OpenAI-kompatible Schnittstelle, Free Tier
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Anthropic (https://console.anthropic.com/settings/keys), nur nötig wenn LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- RAG-Service (services/rag) ---
# Default passt für lokale Entwicklung, egal ob nativ (uv run uvicorn) oder
# über docker compose gestartet (Port wird dort ebenfalls auf 8001 gemappt).
RAG_SERVICE_URL=http://localhost:8001
RAG_SEARCH_TIMEOUT_MS=5000
RAG_SEARCH_TOP_K=3

# --- Auth ---
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
JWT_SECRET=

# --- Observability (Langfuse, https://cloud.langfuse.com) ---
# Free Tier: 50.000 Units/Monat, keine Kreditkarte nötig. Ohne beide Keys
# bleibt Tracing sauber deaktiviert (siehe apps/api/src/tracing.ts) - das
# Projekt läuft auch ohne Langfuse-Account.
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
