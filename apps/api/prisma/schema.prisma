// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum StopCategory {
  FOOD
  CULTURE
  SIGHTSEEING
  ACCOMMODATION
  TRANSPORT
  OTHER
}

model User {
  id          String      @id @default(cuid())
  email       String      @unique
  createdAt   DateTime    @default(now())
  itineraries Itinerary[]
}

model Itinerary {
  id          String   @id @default(cuid())
  destination String
  startDate   DateTime
  endDate     DateTime
  budgetCents Int
  currency    String   @default("EUR")
  preferences String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  userId String

  stops ItineraryStop[]

    @@index([userId])
}

model ItineraryStop {
  id          String       @id @default(cuid())
  dayNumber   Int
  order       Int
  title       String
  description String?
  category    StopCategory @default(OTHER)
  costCents   Int?
  createdAt   DateTime     @default(now())

  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  itineraryId String

  @@index([itineraryId])
}

// Wissensbasis für RAG (Phase 3/4): eine Quelle (z.B. ein Reiseziel-Artikel)
// pro Document, in Chunks zerlegt für die Vektorsuche.
model Document {
  id        String   @id @default(cuid())
  title     String
  source    String
  url       String?
  license   String
  language  String   @default("de")
  // Relativer Dateiname in data/knowledge (z.B. "lissabon.md") - stabiler
  // Schlüssel, über den die Python-Ingestion-Pipeline (services/rag) eine
  // Markdown-Datei über mehrere Läufe hinweg wiedererkennt.
  sourcePath String  @unique
  // sha256 über den kompletten Datei-Inhalt (Frontmatter + Text). Ändert
  // sich der Hash nicht, überspringt die Ingestion die Datei komplett -
  // das macht sie idempotent, ohne bei jedem Lauf neu zu embedden.
  contentHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chunks DocumentChunk[]
}

model DocumentChunk {
  id         String   @id @default(cuid())
  content    String
  chunkIndex Int
  createdAt  DateTime @default(now())

  // pgvector-Spalte: Prisma kennt den Postgres-Typ `vector` nicht nativ
  // (kein eigener Skalartyp im Schema-Modell). `Unsupported` lässt den
  // rohen Postgres-Typ unverändert durch die Migration durch, erzeugt aber
  // keine Felder im generierten Prisma Client - Lesen/Schreiben/Vektorsuche
  // läuft für diese Spalte über $queryRaw/$executeRaw (siehe Phase 3/4).
  // 384 Dimensionen passend zum lokalen Embedding-Modell im RAG-Service
  // (services/rag, sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
  // via fastembed - das einzige mehrsprachige Modell mit 384 Dimensionen in
  // fastembeds Registry, siehe services/rag/src/rag_service/config.py);
  // bei Modellwechsel muss diese Zahl und der bestehende Datenbestand neu
  // embedded werden.
  embedding Unsupported("vector(384)")

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String

  @@index([documentId])
}