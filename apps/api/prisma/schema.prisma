// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AgentRunStatus {
  RUNNING
  OK
  ERROR
  ABORTED
}

enum StopCategory {
  FOOD
  CULTURE
  SIGHTSEEING
  ACCOMMODATION
  TRANSPORT
  OTHER
}

model User {
  id          String      @id @default(cuid())
  email       String      @unique
  createdAt   DateTime    @default(now())
  itineraries   Itinerary[]
  conversations Conversation[]
  agentRuns     AgentRun[]
  tripDrafts    TripDraft[]
}

model Itinerary {
  id          String   @id @default(cuid())
  destination String
  startDate   DateTime
  endDate     DateTime
  budgetCents Int
  currency    String   @default("EUR")
  preferences String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  userId String

  stops ItineraryStop[]

    @@index([userId])
}

model ItineraryStop {
  id          String       @id @default(cuid())
  dayNumber   Int
  order       Int
  title       String
  description String?
  category    StopCategory @default(OTHER)
  costCents   Int?
  // Koordinaten des Programmpunkts für die Route auf dem Globus. Optional:
  // ältere Pläne und Punkte ohne festen Ort (z.B. "Freizeit") haben keine.
  lat         Float?
  lng         Float?
  createdAt   DateTime     @default(now())

  itinerary   Itinerary @relation(fields: [itineraryId], references: [id], onDelete: Cascade)
  itineraryId String

  @@index([itineraryId])
}

// Wissensbasis für RAG: eine Quelle (z.B. ein Reiseziel-Artikel)
// pro Document, in Chunks zerlegt für die Vektorsuche.
model Document {
  id        String   @id @default(cuid())
  title     String
  source    String
  url       String?
  license   String
  language  String   @default("de")
  // "travel" oder "jobs" - trennt die geteilte RAG-Instanz in fachliche
  // Wissensbasen. Default "travel" ordnet bestehende Dokumente bei
  // der Migration automatisch der bisherigen (einzigen) Domäne zu, ohne
  // Backfill-Schritt.
  collection String  @default("travel")
  // Relativer Dateiname in data/knowledge (z.B. "lissabon.md") - stabiler
  // Schlüssel, über den die Python-Ingestion-Pipeline (services/rag) eine
  // Markdown-Datei über mehrere Läufe hinweg wiedererkennt.
  sourcePath String  @unique
  // sha256 über den kompletten Datei-Inhalt (Frontmatter + Text). Ändert
  // sich der Hash nicht, überspringt die Ingestion die Datei komplett -
  // das macht sie idempotent, ohne bei jedem Lauf neu zu embedden.
  contentHash String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chunks DocumentChunk[]

  @@index([collection])
}

model DocumentChunk {
  id         String   @id @default(cuid())
  content    String
  chunkIndex Int
  createdAt  DateTime @default(now())

  // pgvector-Spalte: Prisma kennt den Postgres-Typ `vector` nicht nativ
  // (kein eigener Skalartyp im Schema-Modell). `Unsupported` lässt den
  // rohen Postgres-Typ unverändert durch die Migration durch, erzeugt aber
  // keine Felder im generierten Prisma Client - Lesen/Schreiben/Vektorsuche
  // läuft für diese Spalte über $queryRaw/$executeRaw (services/rag).
  // 384 Dimensionen passend zum lokalen Embedding-Modell im RAG-Service
  // (services/rag, sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
  // via fastembed - das einzige mehrsprachige Modell mit 384 Dimensionen in
  // fastembeds Registry, siehe services/rag/src/rag_service/config.py);
  // bei Modellwechsel muss diese Zahl und der bestehende Datenbestand neu
  // embedded werden.
  embedding Unsupported("vector(384)")

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentId String

  @@index([documentId])
}

// Chat-Verlauf des Agenten. Lag vorher in einer Map im Arbeitsspeicher: Bei
// mehreren Instanzen (maxReplicas: 3) oder nach einem Neustart vergaß der
// Agent die Unterhaltung, und die Map wuchs unbegrenzt. messages ist die
// bereits gekürzte LlmMessage-Liste (siehe ConversationStore).
model Conversation {
  id        String   @id @default(cuid())
  sessionId String
  messages  Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([userId, sessionId])
  @@index([updatedAt])
}

// Zwischenspeicher für Antworten externer APIs (Open-Meteo, später Overpass,
// Frankfurter). Die Gratis-APIs haben Rate-Limits und schwankende Latenz,
// und ein zweiter gleicher Aufruf (Folgefrage, Eval-Lauf) soll dieselben
// Daten liefern. In der Datenbank statt im Arbeitsspeicher, damit alle
// Instanzen und jede nach einem Kaltstart denselben Cache sehen.
// key ist z. B. "open-meteo:forecast:38.72,-9.14:2026-10-03:2026-10-06".
model ExternalApiCache {
  key       String   @id
  provider  String
  payload   Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// Ein Agentenlauf (eine Nutzernachricht über POST /agent/runs) mit allen
// Ereignissen, damit er sich unter /replay?run= erneut abspielen lässt.
// Gespeichert wird einmal am Ende des Laufs, nicht pro Ereignis. Die Summen
// liegen zusätzlich als Spalten vor, damit Auswertungen (z. B. Tokens pro
// Gast und Tag) ohne das JSON auskommen. events enthält message.completed
// und damit Nutzertext: nur für den Eigentümer abrufbar.
// id wird im Controller vor dem Lauf erzeugt (randomUUID), damit sie schon
// in run.started mitgeht; der Default greift nur, wenn keine gesetzt ist.
model AgentRun {
  id           String         @id @default(cuid())
  sessionId    String
  status       AgentRunStatus @default(RUNNING)
  llmCalls     Int            @default(0)
  toolCalls    Int            @default(0)
  inputTokens  Int            @default(0)
  outputTokens Int            @default(0)
  // Integer statt Float wie budgetCents: 1 = 0,000001 US-Dollar
  costMicroUsd Int            @default(0)
  durationMs   Int?
  // RunEvent[] in der Reihenfolge von seq, höchstens 500
  events       Json           @default("[]")
  createdAt    DateTime       @default(now())
  finishedAt   DateTime?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@index([userId, createdAt])
}

// Letzter Entwurf des Multi-Agenten-Modus pro Chat-Session, damit
// Folgenachrichten ("Tag 2 entspannter", "günstiger übernachten") ihn gezielt
// ändern, statt die ganze Reise neu zu recherchieren und zu planen.
// brief = TripBrief, draft = TripDraft (Tage, Stops, Koordinaten), findings =
// ResearchFindings (Wetter, Unterkünfte, Anreise, Treffer), budget = letzter
// BudgetReport; Typen in apps/api/src/orchestrator/trip-draft.ts. revision
// zählt die Fassungen in der Session (1 = erster Plan). Enthält Nutzerangaben
// (Ziel, Vorlieben) und liegt deshalb nicht länger als der Chat-Verlauf
// (CONVERSATION_RETENTION_DAYS).
model TripDraft {
  id        String   @id @default(cuid())
  sessionId String
  revision  Int      @default(1)
  brief     Json
  draft     Json
  findings  Json
  budget    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([userId, sessionId])
  @@index([updatedAt])
}
