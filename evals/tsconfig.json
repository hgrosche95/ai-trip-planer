{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    // Die Szenario-Evals importieren Typen und Regeln aus apps/api, dessen
    // DTOs Decorators nutzen
    "experimentalDecorators": true,
    "types": ["node"]
  },
  "include": ["src"]
}
